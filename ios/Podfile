# Uncomment this line to define a global platform for your project
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  # IosAwnCore (pulled in by awesome_notifications) builds with
  # BUILD_LIBRARY_FOR_DISTRIBUTION = YES, and CocoaPods propagates that into the
  # Pods-Runner aggregate xcconfig that the app target inherits. That makes Swift
  # emit a module interface for Runner, which is incompatible with its bridging
  # header — the build fails with "Using bridging headers with module interfaces
  # is unsupported". Pin the app target back to NO; the pods keep their own value.
  installer.aggregate_targets.each do |aggregate_target|
    aggregate_target.xcconfigs.each do |config_name, config_file|
      config_file.attributes['BUILD_LIBRARY_FOR_DISTRIBUTION'] = 'NO'
      config_file.save_as(aggregate_target.xcconfig_path(config_name))
    end
  end

  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
        '$(inherited)',
        'PERMISSION_CAMERA=1',
        'PERMISSION_MICROPHONE=1',
        'PERMISSION_PHOTOS=1',
        'PERMISSION_PHOTOS_ADD_ONLY=1',
        'PERMISSION_MEDIA_LIBRARY=1',
        'PERMISSION_LOCATION_WHENINUSE=1',
        'PERMISSION_LOCATION_ALWAYS=1',
      ]
    end
  end

  # file_picker's FileUtils conflicts with Apple's private OSAnalytics.framework.
  # Only run if files haven't been renamed yet (idempotent guard).
  file_picker_dir = installer.sandbox.pod_dir('file_picker')
  original_headers = Dir.glob("#{file_picker_dir}/**/FileUtils.{h,m}")
  unless original_headers.empty?
    Dir.glob("#{file_picker_dir}/**/*.{h,m}").each do |file|
      content = File.read(file)
      File.write(file, content.gsub('FileUtils', 'FPFileUtils')) if content.include?('FileUtils')
    end
    original_headers.each do |file|
      new_path = file.gsub('/FileUtils.', '/FPFileUtils.')
      File.rename(file, new_path) unless File.exist?(new_path)
    end
  end
end
